{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "astro dev --host",
    "stage": "astro dev -- --host --mode staging",
    "start": "astro dev",
    "prebuild": "git submodule update --init --recursive --remote",
    "about:prebuild": "echo 'Track remote changes for 'content' submodule'",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.25.0",
    "astro": "^7.1.3",
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-is-element": "^3.0.0",
    "mdx": "^0.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "wrangler": "^4.93.0"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "vite-plugin-qrcode": "^0.4.1"
  }
}
