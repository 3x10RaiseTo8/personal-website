---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/siteConfig";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const {
  title,
  description,
  publishDate,
  lastModified = new Date(remarkPluginFrontmatter.lastModified),
} = post.data;

const dateFormat = [
  "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
] as const;
const publishDateString = publishDate.toDateString();
const prettyPublishDate = publishDate.toLocaleDateString(...dateFormat);
const lastModifiedString = lastModified.toDateString();
const prettyLastModified = lastModified.toLocaleDateString(...dateFormat);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  image: `${SITE.website}/og/p/${post.id}.png`,
  datePublished: publishDate.toISOString(),
  dateModified: lastModified.toISOString(),
  author: [
    {
      "@type": "Person",
      name: SITE.author,
      url: SITE.website,
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  pubDatetime={publishDate}
  modDatetime={lastModified}
  ogImage={`/og/p/${post.id}.png`}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <article>
    <h1>{title}</h1>
    <Content />
    <div class="timestamp">
      Published on <time datetime={publishDateString}>{prettyPublishDate}</time>
      <br />
      Last Updated on <time datetime={lastModifiedString}>
        {prettyLastModified}
      </time>
    </div>
  </article>
</Layout>

<style>
  .timestamp {
    font-size: var(--font-size--1);
    color: var(--tx-2);
    padding-block-start: 4rem;
    text-align: center;
  }
</style>
