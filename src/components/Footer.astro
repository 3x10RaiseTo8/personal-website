---
import { SITE } from "@/siteConfig";

import { getFooterLinks } from "@/utils/links";
import { getTags } from "@/utils/posts";

import TagList from "@/components/TagList.astro";
import happy from "@/assets/happy.gif";

const footerLinks = getFooterLinks(SITE.links);
const tags = await getTags();
---

<footer>
  <section class="tag-list-section">
    <TagList tags={tags} />
  </section>

  <section class="footer-hero">
    <img
      src={happy.src}
      width={happy.width}
      height={happy.height}
      alt="happy"
    />
    <div class="link-group">
      <a href="/about">about</a>
      <a href="/p/blogroll">blogroll</a>
      <a class="external-link" target="_blank" href="/rss.xml">rss</a>
    </div>
    <div class="link-group">
      {
        footerLinks.map((l) => (
          <a
            class="external-link"
            href={`${l.url}?utm_source=personal_website&utm_campaign=footer`}
            target="_blank"
            rel="noopener noreferrer nofollow"
          >
            {l.text}
          </a>
        ))
      }
    </div>
  </section>

  <small>
    <p>{SITE.copyrightText}</p>
    <p>
      The content is licensed under{" "}
      <a
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        target="_blank"
        rel="noopener"
      >
        CC BY-NC-SA 4.0
      </a>. The code is licensed under{" "}
      <a
        href="https://www.gnu.org/licenses/agpl-3.0.html"
        target="_blank"
        rel="noopener"
      >
        GNU AGPL v3.0
      </a> and available <a
        href="/source"
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        here
      </a>.
    </p>
  </small>
</footer>

<style>
  footer {
    block-size: calc(100vh - var(--pad));
    font-size: var(--font-size--2);
    text-align: center;
    display: flex;
    flex-direction: column;
    margin-block-start: 5.5rem;
  }

  .tag-list-section {
    padding-block: var(--gap);
  }

  .footer-hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--tx);
    padding: var(--pad);
    gap: var(--gap);
  }

  .link-group {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 1rem;
    font-size: var(--font-size--1);
  }

  img {
    align-self: center;
  }

  small {
    padding-block-start: var(--pad);
  }

  small p {
    margin: 0;
    color: var(--tx-2);
  }

  small a {
    text-decoration-color: inherit;
  }
</style>
